# OpenAI (required for content generation)
OPENAI_API_KEY=

# Telegram bot (required for the bot; chat can be set via /set_target)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone for scheduled posts (optional)
TIMEZONE=Europe/Berlin

# VK crosspost (optional; leave empty to skip VK)
VK_API_KEY=
VK_GROUP_ID=

# Flask
SECRET_KEY=dev-secret-key

# NewsAPI (optional, for Flask news features)
NEWSAPI_KEY=
